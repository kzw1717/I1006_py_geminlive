# このファイルを .env にコピーして、自分の API キーを設定してください。
#   cp .env.example .env
#
# API キーは Google AI Studio で無料で取得できます:
#   https://aistudio.google.com/apikey

# 必須: Gemini API キー
GEMINI_API_KEY=ここにあなたのAPIキーを貼り付け

# 任意: 使用するモデルを変更したいとき（通常は変更不要）
# Live API のモデル一覧: https://ai.google.dev/gemini-api/docs/models
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# 任意: Gemini の声（プリセット音声名）
# GEMINI_VOICE=Aoede
